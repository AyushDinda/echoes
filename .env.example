# ==========================================
# ECHOES: The Ghost in Your Terminal
# Environment Configuration Template
# ==========================================

# Backend Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./echoes.db

# Ollama Local AI Configuration
# Default base URL for locally running Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434

# Configurable open-weight model (e.g. qwen3, qwen2.5, llama3.1)
OLLAMA_MODEL=qwen3

# Set to true for automated testing, CI, or offline mode without Ollama
MOCK_AI=false

# Request timeout for Ollama inference in seconds
AI_TIMEOUT_SECONDS=30.0
